          "legendFormat": "{{strategy}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "okane-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
