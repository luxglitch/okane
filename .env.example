# =============================================================================
# Okane — Environment Configuration
# Copy this file to .env and fill in your values before running.
# =============================================================================

# ─── Kalshi API ───────────────────────────────────────────────────────────────
# Your Kalshi API key ID (from the Kalshi developer portal)
KALSHI_API_KEY_ID=

# Your RSA private key PEM, base64-encoded (single line, no newlines)
# To encode: base64 -w 0 your_private_key.pem
KALSHI_PRIVATE_KEY_B64=

# API base URL — use demo for testing, live for real data
KALSHI_BASE_URL=https://trading-api.kalshi.com/trade-api/v2
# KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

# Set to "true" to use demo API (overrides KALSHI_BASE_URL)
USE_DEMO_API=false

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: anthropic | deepseek | llamacpp
LLM_PROVIDER=anthropic

# ─── Anthropic API ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── DeepSeek API ─────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
# deepseek-chat (general) or deepseek-reasoner (o1-style, slower, higher cost)
DEEPSEEK_MODEL=deepseek-chat

# ─── llama.cpp Server (local / external) ──────────────────────────────────────
# Only used when LLM_PROVIDER=llamacpp
# Point this at your already-running server — can be local or on another machine.
# Examples:
#   http://localhost:8080/v1         (running on this machine)
#   http://192.168.1.50:8080/v1      (running on another machine on your LAN)
LLAMACPP_BASE_URL=http://localhost:8080/v1
# Model name for logging. If left as "local", agent-core will probe /v1/models
# at startup and auto-detect whatever model is loaded. Only override this if
# you want a specific name in the logs regardless of what the server reports.
LLAMACPP_MODEL=local
# Path to the .gguf model file inside the llamacpp container (mounted at /models)
LLAMACPP_MODEL_FILE=model.gguf
# Number of CPU threads for inference
LLAMACPP_THREADS=4
# Context window size
LLAMACPP_CTX_SIZE=4096
# GPU layers to offload (0 = CPU only; set higher if you have a GPU)
LLAMACPP_GPU_LAYERS=0

# ─── PostgreSQL / TimescaleDB ─────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=okane
POSTGRES_USER=okane
POSTGRES_PASSWORD=

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ─── Paper Broker ─────────────────────────────────────────────────────────────
PAPER_BROKER_URL=http://paper-broker:8001
STARTING_BALANCE=10000.0

# ─── Agent Configuration ──────────────────────────────────────────────────────
# How often the fetcher polls Kalshi (seconds)
FETCH_INTERVAL_SECONDS=30

# How often the agent runs its decision loop (seconds)
AGENT_CYCLE_SECONDS=60

# Maximum LLM calls per minute (cost control)
LLM_MAX_CALLS_PER_MINUTE=10

# Maximum LLM calls per day (cost control)
LLM_MAX_CALLS_PER_DAY=200

# Minimum confidence score to generate a trade signal (0.0-1.0)
MIN_SIGNAL_CONFIDENCE=0.65

# Maximum fraction of portfolio per single trade (0.0-1.0)
MAX_POSITION_FRACTION=0.05

# Daily loss limit as fraction of portfolio before agent pauses
DAILY_LOSS_LIMIT_FRACTION=0.05

# ─── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=
